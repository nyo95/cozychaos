{
  "name": "cozy-chaos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Draw Magic. Expect Chaos. — casual online physics duel",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "tsx watch server/src/index.ts",
    "start:server": "tsx server/src/index.ts",
    "play": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=client && npm run build --workspace=server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "tsc --build --force"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
