{
  "name": "cozy-chaos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Draw Magic. Expect Chaos. — casual online physics duel",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "tsc --build --force"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
