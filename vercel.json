{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "fluid": true,
  "regions": ["sin1"],
  "functions": {
    "api/ws.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/ws",
      "destination": "/api/ws"
    }
  ]
}
